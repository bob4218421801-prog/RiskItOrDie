const HELP = {"blood": ["血煞命局", "首擲7、11破陣；2、3、12鎖命；其餘成為生門。\n生門確定後，先擲回生門就贏，先遇7就輸。\n每局可花靈石逆命一次，只重擲一骨。天機閣禁物另計次數。"], "jade": ["演命玉骨", "七或十一直接贏，二、三、十二輸；其餘定為生門。\n之後先擲出生門便贏，先撞上七便輸。\n陪小師妹玩，不需下注。"], "sect": ["宗門", "山門之內，總有人等你回來。\n有空便去看看師父與同門，俸祿到了，也別忘了順手領走。"], "sicbo": ["宗門骰寶", "每期俸祿可安穩領取，或押一注骰寶。\n小為4–10，大為11–17；三顆相同是豹子，大小與單雙全輸。\n也可押任意豹子或指定總點數。標示倍率為收回總額。"], "pavilion": ["天機閣", "使用天機大比所得天機券，兌換對付魔修的秘術與禁物。\n每件道具的用法，可在兌換前查看。"], "calendar": ["天元曆", "歲月隨修煉前進。宗門大比每十年一次，天機大比每二十五年一次。\n築基後可參賽，錯過就要等下一屆。"], "tournament": ["大比", "宗門大比三戰，天機大比五戰。\n大比禁用問劍神通與神通符。"], "foundation": ["九宫灵纹铸基", "初铸九格不消耗次数，最多重铸三次。点击灵纹锁定，重铸只改变未锁定格。\n锁定在实际重铸后固定，之前可取消。稳定度依次为100%、72%、42%、42%；低稳定度可能降品、冲突、出现瑕疵或失去稀有类型。\n随时可定型；次数用尽必须定型。一品最低，九品最高，品数修炼加成沿用原表。"], "active_duel": ["問劍榜", "先看對手的劍路、彩頭和落敗代價，再遞劍帖。\n每批每人可戰一次，二十次修煉後有新劍帖。"], "preparation": ["結丹準備", "五種丹藥與護道寶物，都可在這裡清點。\n先備好丹材，靜待結丹之機。"], "auto": ["自動修煉", "開啟後會自行聚氣、收功，照常耗去壽元，也可能走火入魔。\n想親自把握收功時機，隨時可以關閉。"], "opportunities": ["機緣", "選一次歷練，再決定投入幾張券。\n築基後也能投入靈石，兩者可以混用。份數越多，這一局的收穫與損失也越大。"], "lobby": ["洞府", "帶回的原石可在這裡解開，材料能用來煉丹。\n也能清點丹藥，準備結丹。"], "flying_boat": ["飛升靈舟", "靈舟越飛越遠，收益逐漸增加。及時收取，墜毀就全失。\n可投入多張券；築基後可加靈石。免費券與靈石每份起額不同，啟航前會列清楚。"], "sword_race": ["飛劍競速", "五柄飛劍即將同場競逐。\n挑一柄你看好的飛劍，押上這一場的籌碼。\n它若率先奪魁，你便按賠率收下獎勵；若未能奪魁，這一注便作罷。"], "mines": ["靈礦探寶", "逐格尋晶，隨時收取。撞上煞氣，未帶走的收穫全失。\n多份投入共走這一趟，帶回的收益按份數增加。"], "stone_gambling": ["解石坊", "按住拖曳磨開原石：外皮、見玉、取芯。\n見到材料就能收手，繼續磨可能得珍物，也可能石裂。\n護石符保前層，催靈術增珍物也增風險，天眼先看線索。"], "alchemy": ["煉丹", "先試爐：按住升火，鬆手降火，把火候留在丹火區。\n丹成可收下，也可再煉一火爭上品；失手會連已成的丹一起失去。\n正式煉丹要付材料與靈石，試爐可以反覆練習。"], "practice": ["試爐", "按住升火，鬆手降火。火候合適，丹胚才會成形。\n持續過熱會炸爐，先看爐壁的警兆。試爐可以反覆練習。"], "duel": ["問劍", "劍勢越接近二十一越強，超過便爆勢。可繼續出劍，或收劍讓對手追。\n靈印可算一或十一。起手十或十一可孤注一劍，再拿一印便收劍，勝負算兩籌。"], "materials": ["材料庫", "解石所得的材料都收在這裡，可留作煉丹。"]}
const UNLOCKS = {"sword_notice":["劍帖漸起","踏入築基之後，你也算真正進了同輩修士的視線。\n築基修士之間時常以問劍切磋，往後或許會有人主動找上門來。"],"blood": ["魔修盯上了你", "築基之後，外出可能遇到魔修。\n留意命骨上的生門與七煞，天機閣也有對付他們的禁物。"], "calendar": ["世間有了你的足跡", "主畫面【年曆】可看宗門大比與天機大比的日期。"], "tournament": ["可以參加大比了", "你已取得築基修士的參賽資格。\n宗門大比每十年一次，天機大比每二十五年一次，開場時會收到劍帖。"], "foundation": ["練氣圓滿", "已能登上【九宫灵纹铸基】。\n凝成道基，就能繼續修行並延長壽元。"], "real_alchemy": ["可以正式開爐了", "你已學會控火。\n到【洞府 → 煉丹】選配方，備好材料與靈石就能開爐。"], "opportunities": ["可以下山歷練了", "你已獲得第一張機緣券。\n到主畫面【機緣】看看吧。"], "flying_boat": ["靈舟已備好", "你已獲得靈舟券。\n入口在【機緣 → 飛升靈舟】。"], "auto": ["可以自動修煉了", "築基後吐納漸熟，可在主畫面開啟【自動修煉】。\n它會自行收功，仍要留意壽元與修為。"], "lobby": ["有自己的洞府了", "【洞府】可以解石、煉丹和準備結丹物資。\n宗門送來下品原石三枚、中品原石一枚。"], "sword_race": ["飛劍競速開放", "【機緣 → 飛劍競速】可選劍參賽。\n每十次修煉得一張券，築基後也可付靈石。"], "mines": ["可以進礦尋晶了", "【機緣 → 靈礦探寶】可逐格尋晶。\n每二十次修煉得一張券。"], "stone_gambling": ["解石坊開門了", "到【洞府 → 解石坊】磨開原石，看看石中藏了什麼。"], "alchemy": ["丹爐已備妥", "到【洞府 → 煉丹】先試試控火，再選配方開爐。"], "preparation": ["先備好結丹所需", "【洞府 → 結丹準備】可查看五種丹藥與護道寶物。"], "duel": ["劍帖登門", "你近來聲名漸起，已有劍修前來邀戰。\n往後若有人遞來劍帖，是否應戰，由你自己決定。"], "active_duel": ["可以主動問劍了", "築基二層，可從主畫面【問劍】挑選對手。\n每二十次修煉會有新劍帖。"], "skill0": ["神識探查已掌握", "與大師姐一戰後，你學會了神識探查。\n普通問劍每小局可施放一次，凝神三秒後揭開藏印；大比禁用神通。"], "skill1": ["劍罡護體已掌握", "每場第一次爆勢會穩住在二十，隨後收劍。\n可在普通問劍使用；大比禁用神通。"], "skill2": ["天命一劍已掌握", "每場第一次孤注一劍，最終劍勢必到二十一。\n可在普通問劍使用；大比禁用神通。"], "skill3": ["窺天一線已掌握", "出劍前能看見下一枚劍印。\n可在普通問劍使用；大比禁用神通。"], "skill4": ["逆轉光陰已掌握", "每場可重開當前小局一次，重新發印。\n可在普通問劍使用；大比禁用神通。"], "pavilion": ["天機閣開放", "主畫面【天機閣】可用天機券兌換秘術與禁物。"]}
