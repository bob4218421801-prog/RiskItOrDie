extends RefCounted
# Presentation-only pools use deterministic cycling; gameplay RNG is never consumed.
const POOLS={
 "before":[["此地云深，无人会听见你的求援。交出灵石，或入阵寻命。","山路到此为止。你身上的灵气，正好祭阵。"],["几名同道折在你手上，今日该还这笔债了。","你的名字已传到谷中。别以为破过几道阵，就能一直活着。"],["连破我道数局，倒真留不得你了。此阵为你而设。","我记得你的剑，也记得败在你手下的人。今夜不会再放你走。"],["黑崖那些人的命账，都记在你的名字之下。今日由我来收。","你的旧敌已葬荒谷，他们留下的血印，却还认得你。"]],
 "win":[["阵眼竟被你破了……此事不会就此作罢。","今日算你命硬。这条路，我会再来。"],["又是你……撤阵。来日自有人向你讨还。","你破得了此阵，未必破得了下一阵。"],["竟仍困不住你。你的命数，比传闻更难断。","退。把此人的名字记清楚，不可再轻敌。"],["黑崖的旧账又添一笔。总有一日，血债一并清算。","连这座阵也留不住你……传令，此人不可独战。"]],
 "loss":[["你的气息乱了。留下代价，再记住今日的生门。","阵已封命。收下你的灵石，饶你这一回。"],["破过几次阵，也终究会有失手之时。","同道的旧账，今日先收这一笔。"],["你也会败。传闻中的命数，并非不可折断。","这一回，你没能从阵中全身而退。"],["那些死在荒谷的人，终于等到一点回响。","你的旧名震不住此阵。这笔债，还远没有清。"]]}
static func line(wins: int, stage: String, serial: int) -> String:
 var tier:=0 if wins<2 else (1 if wins<5 else (2 if wins<10 else 3))
 var pool: Array=POOLS[stage][tier]
 return pool[posmod(serial,pool.size())]
